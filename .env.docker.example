# 默认 secrets 目录（bootstrap 后通常为 ~/solver-secrets）
# 复制为 .env 并设置 GH_TOKEN（仅宿主机 bootstrap 用，勿提交）
#   cp .env.docker.example .env

SECRETS_DIR=${SECRETS_DIR:-${HOME}/solver-secrets}
GH_TOKEN=

# 可选：覆盖 pipeline 默认 repo（secrets/.env 里也有 HF_REPO_ID）
# HF_REPO_ID=Tsumugii/sia-12-sod-30

# 可选：使用已 push 的镜像，跳过本地 build
# SOLVER_IMAGE=ghcr.io/tsumugii24/solver-pipeline:latest
